easyblock = 'Binary'

name = 'Schrodinger_Ubuntu_Container'
version = '2025-4'

homepage = 'https://www.schrodinger.com/'
description = """ Schrodinger aims to provide integrated software solutions and services
 that truly meet its customers needs. We want to empower researchers around the world to
 achieve their goals of improving human health and quality of life through advanced computational
 techniques that transform the way chemists design compounds and materials. """

toolchain = SYSTEM

modloadmsg = """--------------------------------------------
This module loads an experimental build of Schrodinger from
an apptainer container image. It does not support multi-node
jobs. Proceed with caution.
------------------------------------------------------------
Available Commands: apptainer-shell apptainer-exec
------------------------------------------------------------"""

toolchain = SYSTEM
osdependencies = [("p7zip-plugins", "p7zip-full")]  # for extracting iso-files

sources = [
    {"filename": "Schrodinger_Ubuntu_Container_2025-4.def"},
    {"filename": "Schrodinger_Suites_2025-4_Linux-x86_64.tar"}
]
checksums = [
    {"%(name)s_%(version)s.def"      : "37ed2d8c9e42712c0ad75ed6ae65976f"},
    {"Schrodinger_Suites_2025-4_Linux-x86_64.tar"   : "49f77cf3a4443846bce0b0f07a743087"}
]
extract_sources = False

# launch command
local_shell_launch_command = "apptainer shell --env SCHRODINGER_LICENSE_SERVERS=chem-lic1.shef.ac.uk:53001 --bind /etc/machine-id:/etc/machine-id:ro "  
local_exec_launch_command  = "apptainer exec  --env SCHRODINGER_LICENSE_SERVERS=chem-lic1.shef.ac.uk:53001 --bind /etc/machine-id:/etc/machine-id:ro "  

#Definition file
local_def_file = "%(name)s_%(version)s.def"

# name of the SIF image to generate
local_sif_image = "%(name)s-%(version)s.sif"


#modextravars = {
#    'conda_alma9_container': '%(installdir)s/local_sif_image',
#}

install_cmds = [
    "export SCHRODINGER_INSTALLER=Schrodinger_Suites_2025-4_Linux-x86_64.tar",

    "apptainer build --fakeroot " + local_sif_image + " " + local_def_file,
    "cp " + local_sif_image + " %(installdir)s",
    "mkdir -p %(installdir)s/bin",

    
    "echo \#\!/bin/bash > %(installdir)s/bin/apptainer-shell",
    "echo " + local_shell_launch_command + " %(installdir)s/"  + local_sif_image + " \\\"\\$@\\\"  >> %(installdir)s/bin/apptainer-shell",
    "chmod +x %(installdir)s/bin/apptainer-shell",


    "echo \#\!/bin/bash > %(installdir)s/bin/apptainer-exec",
    "echo " + local_exec_launch_command  + " %(installdir)s/" + local_sif_image + " \\\"\\$@\\\" >> %(installdir)s/bin/apptainer-exec",
    "chmod +x %(installdir)s/bin/apptainer-exec",
]


sanity_check_paths = {
    "files": [ "bin/apptainer-shell", "bin/apptainer-exec" ],
    "dirs"  : [] ,
}


moduleclass = "bio"